    "labels": {
      "ja": {
        "language": "ja",
        "value": "真田信政"
      },
      "en": {
        "language": "en",
        "value": "Sanada Nobumasa"
      }
    },
    "descriptions": {
      "en": {
        "language": "en",
        "value": "Son of Sanada Nobuyuki"
      },
      "ja": {
        "language": "ja",
        "value": "日本の江戸時代前期の大名。信濃埴科藩主、信濃松代藩2代藩主。真田信之の次男。従五位下、大内記、従四位下、侍従。信濃真田氏5代。子に信守（又八郎）、信武（大学）、信福（四男、早世）"
      }
    },
    "aliases": {
      "ja": [
        {
          "language": "ja",
          "value": "円陽院殿威良一中大居士"
        }
      ]
    },
