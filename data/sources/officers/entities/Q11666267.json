    "labels": {
      "ja": {
        "language": "ja",
        "value": "飯尾尚清"
      },
      "en": {
        "language": "en",
        "value": "Iinoo Hisakiyo"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "戦国時代から安土桃山時代の武将。織田氏の家臣。尾張奥田城・北島城主。赤母衣衆。隠岐守・出羽守・正五位上・従四位下・侍従。子に飯尾宗敏（永沼左之助）、横井弥兵衛。"
      }
    },
    "aliases": {
      "ja": [
        {
          "language": "ja",
          "value": "飯尾信宗"
        },
        {
          "language": "ja",
          "value": "茂助"
        }
      ]
    },
