    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "室町時代（戦国時代）の武将。尾張野府城主。坪内昌家の嫡男。織田信秀および織田信康の家臣。坪内氏当主。加納口の戦いで討ち死。"
      },
      "en": {
        "language": "en",
        "value": "Japanese military commander"
      }
