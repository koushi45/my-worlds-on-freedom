    "labels": {
      "en": {
        "language": "en",
        "value": "Mizuno Tadakiyo"
      },
      "ja": {
        "language": "ja",
        "value": "水野忠清"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "江戸時代前期の大名。上野小幡藩主、三河刈谷藩主、三河吉田藩主、信濃松本藩初代藩主。沼津藩水野家初代。水野忠重の四男。母は宇川氏（側室）。従五位下、隼人正。書院番頭、奏者番。子に祖活（三男、僧）"
      }
    },
    "aliases": {
      "ja": [
        {
          "language": "ja",
          "value": "真珠院郭誉全忠"
        }
      ]
    },
