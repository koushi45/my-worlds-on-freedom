    "labels": {
      "en": {
        "language": "en",
        "value": "Aoyama Yoshinari"
      },
      "ja": {
        "language": "ja",
        "value": "青山幸成"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "安土桃山時代から江戸時代前期の武将・大名。遠江掛川藩主、摂津尼崎藩初代藩主。幸成系青山家初代。従五位下・大蔵少輔。子に青山幸通（-1676.11.7、次男、旗本、左近、喜右衛門、丹後守）、青山幸高（四男、旗本、幸隆、藤蔵）"
      }
    },
    "aliases": {
      "ja": [
        {
          "language": "ja",
          "value": "藤蔵"
        },
        {
          "language": "ja",
          "value": "石之助"
        },
        {
          "language": "ja",
          "value": "梅窓院殿前大府香譽淨薫大禪定門"
        }
      ]
    },
