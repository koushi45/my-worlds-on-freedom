    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "安土桃山時代から江戸時代前期の武将。結城秀康の御附家老、越前福井藩・越前松平家筆頭家老4万5千石。越前府中城主。従五位下・伊豆守、丹波守。"
      },
      "en": {
        "language": "en",
        "value": "samurai of the early Edo period"
      }
    },
