    "descriptions": {
      "en": {
        "language": "en",
        "value": "Japanese samurai of the Sengoku period; son of daimyo Hōjō Ujiyasu"
      },
      "ja": {
        "language": "ja",
        "value": "戦国時代、安土桃山時代の武将。北条氏康の四男? 五男? 相模三崎城主、伊豆韮山城城代。"
      }
