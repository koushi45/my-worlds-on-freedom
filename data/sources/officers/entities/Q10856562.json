    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "戦国時代から安土桃山時代の武将、大名、故実家。小笠原長時の三男。信濃深志城城主。小笠原流弓馬術礼法宗家。従五位下。府中小笠原氏18代。"
      },
      "en": {
        "language": "en",
        "value": "(1546-1595)"
      }
