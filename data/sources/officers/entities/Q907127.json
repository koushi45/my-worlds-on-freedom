    "labels": {
      "ja": {
        "language": "ja",
        "value": "小笠原長時"
      },
      "en": {
        "language": "en",
        "value": "Ogasawara Nagatoki"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "戦国時代の武将、戦国大名。府中小笠原氏17代。従五位上、信濃守、大膳大夫。室町幕府 信濃守護職。信濃林城主。小笠原長棟の長男。小笠原流弓馬術礼法宗家。信濃四大将のひとり。子に小笠原貞次。"
      },
      "en": {
        "language": "en",
        "value": "daimyo"
      }
    },
    "aliases": {
