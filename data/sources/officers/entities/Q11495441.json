    "labels": {
      "ja": {
        "language": "ja",
        "value": "成富茂安"
      },
      "en": {
        "language": "en",
        "value": "Shigeyasu Naritomi"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "戦国時代から江戸時代前期にかけての武将。龍造寺氏次いで鍋島氏の家臣。成富信種の次男。母は安住家能の娘。兵庫助、遠江守、刑部少輔、贈従四位。肥前佐賀藩士。子に下村八郎右衛門の妻、大隈安兵衛の妻。"
      }
    },
