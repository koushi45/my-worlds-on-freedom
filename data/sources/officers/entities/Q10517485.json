    "labels": {
      "en": {
        "language": "en",
        "value": "Andō Shigenaga"
      },
      "ja": {
        "language": "ja",
        "value": "安藤重長"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "江戸時代前期の大名。上野高崎藩2代藩主。従五位下・伊勢守、右京亮。対馬守系安藤家2代。本多正盛の長男。江戸幕府 寺社奉行、奏者番。子に安藤重広（次男、旗本寄合席）"
      }
    },
