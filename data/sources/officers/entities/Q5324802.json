    "labels": {
      "ja": {
        "language": "ja",
        "value": "松平直政"
      },
      "en": {
        "language": "en",
        "value": "Matsudaira Naomasa"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "江戸時代前期の大名。上総姉ヶ崎藩主、越前大野藩主、信濃松本藩主、出雲松江藩初代藩主。従五位下出羽守、従四位上左近衛権少将、贈従三位。直政系越前松平家宗家初代。結城秀康の三男。"
      },
      "en": {
        "language": "en",
        "value": "daimyo of the early Edo period; 1st lord of Matsue (1601-1666)"
      }
    },
    "aliases": {
