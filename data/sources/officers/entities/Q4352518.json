    "descriptions": {
      "en": {
        "language": "en",
        "value": "samurai"
      },
      "ja": {
        "language": "ja",
        "value": "安土桃山時代から江戸時代の武将、大名。美濃十七条藩主、松平忠昌の家老、清崎城主、越後糸魚川藩主、下野真岡藩初代藩主。正成系稲葉家宗家初代。林政秀の次男。母は安藤某の娘。従五位下・佐渡守、内匠頭"
      }
    },
    "aliases": {
      "ja": [
        {
          "language": "ja",
          "value": "現龍院殿輝宗道範大居士"
        },
        {
          "language": "ja",
          "value": "政成"
        }
      ]
    },
