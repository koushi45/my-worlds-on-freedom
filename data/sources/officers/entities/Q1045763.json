      "en": {
        "language": "en",
        "value": "Tokugawa Yorinobu"
      }
    },
    "descriptions": {
      "ja": {
        "language": "ja",
        "value": "常陸水戸藩主、駿河駿府藩主、紀伊和歌山藩初代藩主。紀州徳川家の祖。徳川家康の十男。従四位下常陸介、従三位参議・右中将、権中納言、従二位権大納言、贈正二位。"
      },
      "en": {
        "language": "en",
        "value": "daimyo of the early Edo period; 1st lord of Kishu, founder of Kii branch"
      }
    },
